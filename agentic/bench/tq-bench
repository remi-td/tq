#!/usr/bin/env bash
# External agentic benchmark and optimization runner
# Orchestrates tq CLI alongside autonomous coding agents (Claude Code, Gemini, Codex).
# Usage: ./agentic/bench/tq-bench [OPTIONS]
# Example: ./agentic/bench/tq-bench --matrix agentic/bench/configs/final_system_test.yaml --live-db

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Activate virtualenv if present
VENV_PYTHON="$REPO_ROOT/tests/eval_test/.venv/bin/python3"
if [[ -f "$VENV_PYTHON" ]]; then
    PYTHON_CMD="$VENV_PYTHON"
elif command -v python3 &>/dev/null; then
    PYTHON_CMD="python3"
else
    echo "Error: python3 not found" >&2
    exit 1
fi

export PYTHONUNBUFFERED=1
exec "$PYTHON_CMD" -u "$SCRIPT_DIR/runner.py" "$@"

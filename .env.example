# Environment configuration for tq (Teradata Query)
# Copy this file to .env and fill in your actual values
# .env is ignored by git to keep your secrets safe

# Teradata connection logon string
# Format: username:password@host:port/database
# Example: my_dbuser:my_dbpass@db-djtntn9jf63jf6w.env.clearscape.teradata.com:1025/my_dbuser
TQ_LOGON=

# Optional: Log level (trace, debug, info, warn, error)
# RUST_LOG=info
